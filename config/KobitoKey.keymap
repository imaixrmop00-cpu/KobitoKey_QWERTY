#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        lang_kana {
            bindings = <&kp LANG1>;
            key-positions = <5 8>;
        };

        lang_eisu {
            bindings = <&kp LANG2>;
            key-positions = <25 28>;
        };
    };

    macros {
        ctrl_alt_del: ctrl_alt_del {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RCTRL &kp RIGHT_ALT &kp DELETE>;
            label = "CTRL_ALT_DEL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F           &kp Y       &kp R        &kp W      &kp J        &mt RIGHT_ALT X  &kp U            &kp C      &mt RIGHT_SHIFT L  &kp P
&kp H           &kp S       &kp N        &kp T      &kp K        &kp O            &kp A            &kp I      &kp E              &kp TAB
&kp B           &kp Z       &kp M        &kp D      &kp G        &kp V            &kp MINUS        &kp SLASH  &mt RIGHT_SHIFT Q  &kp LEFT_WIN
&kp LEFT_SHIFT  &kp DELETE  &lt 4 SPACE  &lt 1 TAB  &lt 2 ENTER  &lt 2 ENTER      &lt 1 BACKSPACE  &kp RCTRL  &trans             &ctrl_alt_del
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp COMMA  &kp PERIOD       &kp PAGE_UP     &kp UP_ARROW     &kp PAGE_DOWN   &mt RIGHT_ALT N0  &kp N7         &kp N8     &kp NUMBER_9     &kp RIGHT_SHIFT
&kp MINUS  &kp KP_PLUS      &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp DOWN_ARROW  &kp N0            &kp N4         &kp N5     &kp N6           &kp RIGHT_SHIFT
&kp SLASH  &kp KP_MULTIPLY  &kp HOME        &kp END          &kp SEMICOLON   &kp N0            &kp N1         &kp N2     &kp N3           &kp RIGHT_SHIFT
&trans     &trans           &trans          &kp EQUAL        &kp ENTER       &kp ENTER         &kp BACKSPACE  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_SHIFT
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4    &kp RIGHT_ALT    &kp F1   &kp F2           &kp F3           &kp RIGHT_SHIFT
&trans        &trans        &trans        &trans          &bt BT_CLR      &kp F4           &kp F5   &kp F6           &kp F7           &kp RIGHT_SHIFT
&trans        &trans        &trans        &trans          &bt BT_CLR_ALL  &kp F8           &kp F9   &kp F10          &kp F11          &kp RIGHT_SHIFT
&trans        &trans        &kp INSERT    &kp SCROLLLOCK  &kp ESCAPE      &kp RIGHT_SHIFT  &kp F12  &kp RIGHT_SHIFT  &kp RIGHT_SHIFT  &kp RIGHT_SHIFT
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &trans     &mkp LCLK  &mkp RCLK  &kp RIGHT_SHIFT  &trans
&trans     &trans  &trans    &trans    &trans  &trans     &trans     &trans     &trans           &kp TAB
&trans     &trans  &trans    &trans    &trans  &trans     &trans     &trans     &trans           &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &kp ENTER  &trans     &trans     &to 0            &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
