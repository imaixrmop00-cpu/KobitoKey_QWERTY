#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp F           &kp Y       &kp R        &kp W      &kp J        &mt RIGHT_ALT X  &kp U            &kp C      &mt RIGHT_SHIFT L  &kp P
&kp H           &kp S       &kp N        &kp T      &kp K        &kp O            &kp A            &kp I      &kp E              &kp TAB
&kp B           &kp Z       &kp M        &kp D      &kp G        &kp V            &kp MINUS        &trans     &mt RIGHT_SHIFT Q  &kp LEFT_WIN
&kp LEFT_SHIFT  &kp DELETE  &lt 4 SPACE  &lt 1 TAB  &lt 2 ENTER  &lt 2 ENTER      &lt 1 BACKSPACE  &kp RCTRL  &trans             &trans
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp COMMA  &kp PERIOD  &kp PAGE_UP  &kp UP_ARROW    &kp END          &kp N0     &kp N7         &kp N8     &kp NUMBER_9     &kp RIGHT_SHIFT
&kp MINUS  &kp PLUS    &kp HOME     &kp PAGE_DOWN   &kp DOWN_ARROW   &kp N0     &kp N4         &kp N5     &kp N6           &kp RIGHT_SHIFT
&trans     &trans      &kp EQUAL    &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp N0     &kp N1         &kp N2     &kp N3           &kp RIGHT_SHIFT
&trans     &trans      &trans       &kp LSHFT       &trans           &kp ENTER  &kp BACKSPACE  &kp RCTRL  &kp RIGHT_SHIFT  &kp RIGHT_SHIFT
            >;
        };

        layer2 {
            label = "FUNCTION";
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp F1   &kp F2   &kp F3     &kp F4  &kp F5
&trans        &trans        &trans        &trans        &bt BT_CLR      &kp F6   &kp F7   &kp F8     &kp F9  &kp F10
&trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &kp F11  &trans   &trans     &trans  &trans
&trans        &trans        &trans        &trans        &trans          &trans   &kp F12  &kp RCTRL  &trans  &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&trans     &trans  &trans    &trans    &trans  &trans     &mkp LCLK  &mkp RCLK  &kp RIGHT_SHIFT  &trans
&trans     &trans  &trans    &trans    &trans  &trans     &trans     &trans     &trans           &kp TAB
&trans     &trans  &trans    &trans    &trans  &trans     &trans     &trans     &trans           &trans
&kp LSHFT  &trans  &kp LCMD  &kp LALT  &to 0   &kp ENTER  &trans     &trans     &to 0            &kp RALT
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
